# ais-monitor settings. Copy to .env and fill in. Restart after changes: pm2 restart ais-monitor --update-env

# Free key from https://aisstream.io (sign in, API Keys).
AISSTREAM_KEY=

# Places the card can list the closest vessels to: "Name:lat,lon;Name:lat,lon". The first is the default.
# AIS is received for a box of LOCATION_RADIUS_NM around each one (all on one aisstream connection).
LOCATIONS=Halifax Harbour:44.635,-63.555;Saint John Harbour:45.255,-66.065
LOCATION_RADIUS_NM=40

# true: receive the whole world (~100-150 AIS messages/s, ~6.5 GB/day download). The locations still drive the
# card's list and the harbour alerts.
WORLDWIDE=false

# Optional: a wider area to receive as well (centre and radius in nm).
AREA_LAT=
AREA_LON=
AREA_RADIUS_NM=100

# Home Assistant webhook for phone alerts (see ha-automation.yaml). Blank: alerts are only logged.
HA_WEBHOOK=
# Or/also ntfy (no Home Assistant needed: the ntfy app, subscribed to a topic with a long random name).
NTFY_URL=
# NTFY_URL=https://ntfy.sh/ships-pick-a-long-random-name
# Only for a protected ntfy server or topic:
NTFY_TOKEN=
# Opened when you tap an ntfy alert, e.g. this monitor's dashboard:
DASHBOARD_URL=
# Starting harbour circle (nm) for "entering the harbour" alerts; change it later in the card's Alerts tab.
ALERT_RADIUS_NM=6

# How many closest vessels to send by default.
CLOSEST=50

# Sharing with guests: with a password, anyone can look but only you can change alerts (sign in on the Alerts tab).
ADMIN_PASSWORD=
# A Cesium ion token (assets:read) for the Bridge view, handed to everyone using the dashboard, guests included.
CESIUM_TOKEN=

# Port for the dashboard (http://<this machine>:7110/) and the API.
PORT=7110
